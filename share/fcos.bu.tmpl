variant: fcos
version: 1.5.0
passwd:
  users:
    - name: core
      groups: [ sudo, wheel ]
      ssh_authorized_keys:
        - "@SSH_KEY@"
storage:
  files:
    - path: /var/lib/systemd/linger/core
      contents: { inline: "" }
    - path: /etc/sysctl.d/99-rootless.conf
      contents:
        inline: |
          net.ipv4.ip_unprivileged_port_start=80
    # Appended, not a drop-in: FCOS ships no `confdir` in chrony.conf, so nothing under
    # /etc/chrony.d is ever read. The later makestep wins over the stock `makestep 1.0 3`,
    # which only steps during the first three updates after chronyd starts — pausing the
    # host leaves the guest clock days behind long after that, and chrony will only slew.
    - path: /etc/chrony.conf
      append:
        - inline: |
            makestep 1.0 -1
  links:
    # Ignition cannot enable user units, and a link under ~/.config silently fails
    # because Ignition creates the parent dirs as root.
    - path: /etc/systemd/user/sockets.target.wants/podman.socket
      target: /usr/lib/systemd/user/podman.socket
