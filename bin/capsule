#!/usr/bin/env bash
set -euo pipefail

conf="${XDG_CONFIG_HOME:-$HOME/.config}/capsule/config"
# shellcheck source=/dev/null
[[ -f $conf ]] && source "$conf"

self_src="${BASH_SOURCE[0]}"
while [[ -L $self_src ]]; do
  self_dir="$(cd "$(dirname "$self_src")" && pwd)"
  self_src="$(readlink "$self_src")"
  [[ $self_src == /* ]] || self_src="$self_dir/$self_src"
done
self_dir="$(cd "$(dirname "$self_src")" && pwd)"

: "${CAPSULE_VM_HOST:=core@localhost}"
: "${CAPSULE_VM_PORT:=2222}"
: "${CAPSULE_IMAGE:=ghcr.io/stevio89/capsule:latest}"
: "${CAPSULE_CONTAINER_HOME:=/home/agent}"
: "${CAPSULE_DATA:=${XDG_DATA_HOME:-$HOME/.local/share}/capsule}"
: "${CAPSULE_SSH_KEY:=$HOME/.ssh/id_ed25519.pub}"
: "${CAPSULE_VM_CPUS:=4}"
: "${CAPSULE_VM_MEM:=6144}"
: "${CAPSULE_DISK_SIZE:=80G}"
: "${CAPSULE_STREAM:=stable}"
: "${CAPSULE_MCP_PORT:=8765}"
: "${CAPSULE_SRC:=$(cd "$self_dir/.." && pwd)}"
: "${CAPSULE_SHARE:=$CAPSULE_SRC/share}"

die() { echo "capsule: $*" >&2; exit 1; }

[[ $CAPSULE_VM_HOST == *@* ]] || die "CAPSULE_VM_HOST must be user@host (got '$CAPSULE_VM_HOST')"

command -v jq >/dev/null 2>&1 || die "jq is required — install it, or use the Nix package which wires it in"

# CAPSULE_IN_CAPSULE marks any container capsule started; CAPSULE_PROJECT_DIR marks a run
# inside one, and a login container has only the first. Two variables, two jobs.
in_container() { [[ -n ${CAPSULE_IN_CAPSULE:-} ]]; }
host_only() {
  if in_container; then die "'capsule $*' runs on the host, not inside the capsule"; fi
}

vm_is_local() {
  case "${CAPSULE_VM_HOST##*@}" in localhost | 127.0.0.1 | ::1) return 0 ;; *) return 1 ;; esac
}
qemu_only() {
  vm_is_local && return 0
  die "'capsule $*' drives the local qemu VM, but CAPSULE_VM_HOST is $CAPSULE_VM_HOST — manage that machine directly"
}

# One multiplexed connection for every ssh: a fresh handshake costs 200-300ms and a single
# command makes several. %C hashes the connection, because a control socket path is capped
# at 108 bytes.
ctl_dir="${XDG_RUNTIME_DIR:-$CAPSULE_DATA}/capsule"
ssh_opts=(
  -o StrictHostKeyChecking=accept-new
  -o ControlMaster=auto
  -o "ControlPath=$ctl_dir/cm-%C"
  -o ControlPersist=10m
  -o ServerAliveInterval=15
  -o ServerAliveCountMax=3
  -p "$CAPSULE_VM_PORT"
)

ssh_ready() { [[ -d $ctl_dir ]] || { mkdir -p "$ctl_dir" && chmod 700 "$ctl_dir"; }; }

# shellcheck disable=SC2029  # callers pass a remote command that is meant to expand here
ssh_vm() { ssh_ready; ssh "${ssh_opts[@]}" "$CAPSULE_VM_HOST" "$@"; }

vm_home() {
  # shellcheck disable=SC2016  # $HOME must expand on the VM, not here — that is the point
  [[ -n ${_vm_home:-} ]] || _vm_home=$(ssh_vm 'printf %s "$HOME"')
  printf '%s' "$_vm_home"
}

drop_nix_volume() {
  ssh_vm "if podman volume exists capsule-nix; then podman volume rm capsule-nix; fi"
}

vm_running() {
  timeout 2 bash -c "echo > /dev/tcp/${CAPSULE_VM_HOST##*@}/${CAPSULE_VM_PORT}" 2>/dev/null
}

# Never boots anything: booting takes minutes and is an explicit act.
vm_reachable() {
  vm_running && return 0
  if vm_is_local; then
    die "VM not reachable on ${CAPSULE_VM_HOST}:${CAPSULE_VM_PORT} — run 'capsule vm start'"
  fi
  die "$CAPSULE_VM_HOST is not reachable on port $CAPSULE_VM_PORT — start that machine, or check ssh"
}

need_daemon() {
  capsuled ping >/dev/null 2>&1 \
    || die "capsuled is not running — run 'capsule daemon start'"
}

service_manager() {
  if [[ $(uname -s) == Darwin ]] && launchctl print "gui/$(id -u)/dev.capsule.capsuled" >/dev/null 2>&1; then
    echo launchd
  elif command -v systemctl >/dev/null 2>&1 && systemctl --user cat capsuled.service >/dev/null 2>&1; then
    echo systemd
  else
    echo none
  fi
}

cmd_daemon_start() {
  host_only daemon start
  if capsuled ping >/dev/null 2>&1; then
    echo "capsule: daemon already running"; return 0
  fi
  case "$(service_manager)" in
    launchd) launchctl kickstart "gui/$(id -u)/dev.capsule.capsuled" ;;
    systemd) systemctl --user start capsuled.service ;;
    none)
      setsid capsuled daemon >/dev/null 2>&1 &
      ;;
  esac
  local waited=0
  while (( waited < 10 )); do
    capsuled ping >/dev/null 2>&1 && { echo "capsule: daemon started"; return 0; }
    sleep 0.2
    waited=$((waited + 1))
  done
  die "daemon did not come up — try 'capsuled daemon' in the foreground to see why"
}

cmd_daemon_stop() {
  host_only daemon stop
  case "$(service_manager)" in
    launchd) launchctl kill TERM "gui/$(id -u)/dev.capsule.capsuled" ;;
    systemd) systemctl --user stop capsuled.service ;;
    none)    capsuled daemon.stop >/dev/null 2>&1 || true ;;
  esac
  echo "capsule: daemon stopped"
}

cmd_daemon_status() {
  host_only daemon status
  if ! capsuled daemon.status 2>/dev/null; then
    echo "not running — 'capsule daemon start'"
    return 1
  fi
}

# `--git-common-dir` and not `--show-toplevel`, or two worktrees of one repository would
# fork into separate backlogs. `pwd -P` resolves symlinks, which Zig 0.16 cannot.
project_params() {
  local gcd cwd
  gcd=$(git rev-parse --git-common-dir 2>/dev/null) \
    || die "$PWD is not a git repository"
  cwd=$(pwd -P)
  [[ $gcd == /* && -d $gcd ]] && gcd=$(cd "$gcd" && pwd -P)
  printf '{"git_common_dir":%s,"cwd":%s' "$(json_string "$gcd")" "$(json_string "$cwd")"
}

json_string() {
  jq -n --arg s "$1" '$s'
}

cmd_project_add() {
  host_only project add
  need_daemon
  local profile=default
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --profile) profile="${2:-}"; shift 2 ;;
      *) die "usage: capsule project add [--profile <name>]" ;;
    esac
  done
  capsuled project.add "$(project_params),\"profile\":$(json_string "$profile")}"
}

cmd_project_list() {
  host_only project list
  need_daemon
  capsuled project.list '{}'
}

cmd_project_profile() {
  host_only project profile
  need_daemon
  [[ $# -eq 1 ]] || die "usage: capsule project profile <name>"
  capsuled project.profile "$(project_params),\"profile\":$(json_string "$1")}"
}

cmd_project_rm() {
  host_only project rm
  need_daemon
  local force=false
  [[ ${1:-} == --force ]] && force=true

  # project.rm refuses while issues exist, but the remote clean has to run first — the
  # store is what names the replica and the run directories. Asking the same question here
  # keeps a refusal from arriving after the replica is already gone; the daemon still
  # enforces it.
  if [[ $force != true ]]; then
    local issues
    issues=$(capsuled issue.list "$(project_params)}" | jq -r 'length') || exit 1
    [[ $issues == 0 ]] \
      || die "this project still has $issues issue(s) — pass --force to remove it anyway"
  fi

  local replica
  replica=$(capsuled project.get "$(project_params)}" | jq -r '.replica') || exit 1
  # An unreachable VM costs only the remote half: refusing would strand a project that
  # could then never be unregistered.
  if vm_running; then
    reset_vm_side "$replica" "$force"
  else
    echo "capsule: VM unreachable — replica $replica and its run dirs left in place" >&2
  fi
  reset_local_side

  capsuled project.rm "$(project_params),\"force\":$force}"
}

# The daemon's issue.list filters on one state, so a set is narrowed here instead.
pick_issue() { # pick_issue [state[,state...]]
  local listing params rows
  params=$(project_params)
  listing=$(capsuled issue.list "$params}") || exit 1

  rows=$(jq -r --arg want "${1:-}" '
    ($want | split(",") | map(select(length > 0))) as $states
    | .[] | select($states == [] or (.state as $s | $states | index($s)))
    | [.short, .state, .title] | @tsv' <<<"$listing")
  [[ -n $rows ]] || die "no issues here yet — 'capsule issue new <title>'"

  printf '%s\n' "$rows" \
    | fzf --with-nth=2.. --delimiter=$'\t' \
          --preview "capsuled issue.get '${params},\"id\":\"{1}\"}'" \
          --preview-window=right:60% \
    | cut -f1
}

issue_id_or_pick() { # issue_id_or_pick [id] [state]
  if [[ -n ${1:-} ]]; then printf '%s' "$1"; else pick_issue "${2:-}"; fi
}

cmd_issue_new() {
  host_only issue new
  need_daemon
  [[ $# -gt 0 ]] || die "usage: capsule issue new <title>"
  local title="$*" body
  body=$(capsuled edit "" "<!-- describe the issue. save to create it, empty aborts. -->") \
    || { echo "aborted"; return 1; }
  capsuled issue.new "$(project_params),\"title\":$(json_string "$title"),\"body\":$(json_string "$body")}"
}

cmd_issue_list() {
  host_only issue list
  need_daemon
  local filter=""
  [[ -n ${1:-} ]] && filter=",\"state\":$(json_string "$1")"
  capsuled issue.list "$(project_params)$filter}"
}

cmd_issue_edit() {
  host_only issue edit
  need_daemon
  local id; id=$(issue_id_or_pick "${1:-}") || exit 1
  [[ -n $id ]] || { echo "nothing selected"; return 1; }

  local current token body
  current=$(capsuled issue.get "$(project_params),\"id\":$(json_string "$id")}") || exit 1
  token=$(jq -r '.last_event_id' <<<"$current")
  body=$(capsuled edit "$(jq -r '.body' <<<"$current")" \
                       "<!-- edit the body. unchanged is a no-op, empty aborts. -->") \
    || { echo "unchanged"; return 0; }

  capsuled issue.edit \
    "$(project_params),\"id\":$(json_string "$id"),\"body\":$(json_string "$body"),\"last_event_id\":$(json_string "$token")}"
}

cmd_issue_rename() {
  host_only issue rename
  need_daemon
  local id
  if [[ $# -ge 2 ]]; then
    id="$1"; shift
  elif [[ $# -eq 1 ]]; then
    id=$(pick_issue) || exit 1
    [[ -n $id ]] || { echo "nothing selected"; return 1; }
  else
    die "usage: capsule issue rename [id] <title>"
  fi
  capsuled issue.rename "$(project_params),\"id\":$(json_string "$id"),\"title\":$(json_string "$*")}"
}

cmd_issue_comment() {
  host_only issue comment
  need_daemon
  local id text; id=$(issue_id_or_pick "${1:-}") || exit 1
  text=$(capsuled edit "" "<!-- your note. save to add it, empty aborts. -->") \
    || { echo "aborted"; return 1; }
  capsuled issue.comment "$(project_params),\"id\":$(json_string "$id"),\"text\":$(json_string "$text")}"
}

cmd_issue_triage() {
  host_only issue triage
  need_daemon

  local loaded count buffer edited
  loaded=$(capsuled issue.triage.load "$(project_params)}") || exit 1
  count=$(jq -r '.count' <<<"$loaded")
  (( count > 0 )) || { echo "nothing to triage"; return 0; }

  buffer=$(jq -r '.buffer' <<<"$loaded")

  local attempt=0
  while (( attempt < 3 )); do
    edited=$(capsuled edit "$buffer" "") || { echo "unchanged — nothing applied"; return 0; }
    local result
    if result=$(capsuled issue.triage.apply \
                  "$(project_params),\"buffer\":$(json_string "$edited")}" 2>&1); then
      echo "$result"
      return 0
    fi
    echo "$result" >&2
    buffer="<!-- $result -->
$edited"
    attempt=$((attempt + 1))
  done
  die "gave up after three malformed buffers — nothing was applied"
}

cmd_issue_archive() {
  host_only issue archive
  need_daemon
  local id reason=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -m) reason="${2:-}"; shift 2 ;;
      *)  id="$1"; shift ;;
    esac
  done
  [[ -n $reason ]] || die "usage: capsule issue archive [id] -m <reason>"
  id=$(issue_id_or_pick "${id:-}") || exit 1
  capsuled issue.archive "$(project_params),\"id\":$(json_string "$id"),\"reason\":$(json_string "$reason")}"

  offer_memory_review
}

cmd_issue_reopen() {
  host_only issue reopen
  need_daemon
  local id; id=$(issue_id_or_pick "${1:-}" archived) || exit 1
  capsuled issue.reopen "$(project_params),\"id\":$(json_string "$id")}"
  echo "work resumes on the branch it already has"
}

# Only to tell 'issue state open' from 'issue state <id>'. What a human may actually set
# is replay.zig's call, and the daemon makes it — nothing is rejected here.
looks_like_state() {
  case "$1" in
    open | in_progress | blocked | ready_for_review) return 0 ;;
    *) return 1 ;;
  esac
}

cmd_issue_state() {
  host_only issue state
  need_daemon

  local id="" state=""
  case $# in
    1) looks_like_state "$1" || die "usage: capsule issue state [id] <state>"; state="$1" ;;
    2) id="$1"; state="$2" ;;
    *) die "usage: capsule issue state [id] <state>" ;;
  esac

  id=$(issue_id_or_pick "$id") || exit 1
  [[ -n $id ]] || { echo "nothing selected"; return 1; }
  capsuled issue.state \
    "$(project_params),\"id\":$(json_string "$id"),\"state\":$(json_string "$state")}"
}

offer_memory_review() {
  local loaded proposals
  loaded=$(capsuled memory.review.load "$(project_params)}" 2>/dev/null) || return 0
  proposals=$(jq -r '.proposals' <<<"$loaded")
  (( ${proposals:-0} > 0 )) || return 0
  cmd_memory_review
}

cmd_memory_review() {
  host_only memory review
  need_daemon

  local loaded buffer edited result
  loaded=$(capsuled memory.review.load "$(project_params)}") || exit 1
  buffer=$(jq -r '.buffer' <<<"$loaded")

  local attempt=0
  while (( attempt < 3 )); do
    edited=$(capsuled edit "$buffer" "") || { echo "unchanged — nothing applied"; return 0; }
    if result=$(capsuled memory.review.apply \
                  "$(project_params),\"buffer\":$(json_string "$edited")}" 2>&1); then
      echo "$result"
      return 0
    fi
    echo "$result" >&2
    buffer="<!-- $result -->
$edited"
    attempt=$((attempt + 1))
  done
  die "gave up after three refused buffers — nothing was applied"
}

cmd_memory_list() {
  host_only memory list
  need_daemon
  capsuled memory.list "$(project_params)}"
}

cmd_memory_new() {
  host_only memory new
  need_daemon
  local body
  body=$(capsuled edit "" \
    "<!-- one to three sentences: a decision and why, a trap, an approach that failed. -->
<!-- not what the code does, not what happened — those are the code and the event log. -->") \
    || { echo "aborted"; return 1; }
  capsuled memory.new "$(project_params),\"body\":$(json_string "$body")}"
}

cmd_board() {
  host_only board
  need_daemon
  local params=""
  git rev-parse --git-common-dir >/dev/null 2>&1 && params="$(project_params)}"
  exec capsuled board "$params"
}

template() { echo "$CAPSULE_SHARE/templates"; }

rewrite_flake() {
  local tmp; tmp=$(mktemp ./flake.nix.XXXXXX) || die "cannot write to $PWD"
  if "$@" < flake.nix > "$tmp"; then
    mv "$tmp" flake.nix
  else
    rm -f "$tmp"; die "failed to rewrite flake.nix"
  fi
}

inject_pkgs() {
  local marker='# devhelper:packages' indent
  indent=$(awk -v m="$marker" 'index($0, m) { match($0, /^[ \t]+/); print substr($0, 1, RLENGTH); exit }' flake.nix)
  # shellcheck disable=SC2016  # single quotes protect the awk program, not shell vars
  rewrite_flake awk -v m="$marker" -v ind="$indent" -v pkgs="$*" '
    index($0, m) { n = split(pkgs, arr, " "); for (i = 1; i <= n; i++) print ind arr[i] }
    { print }
  '
}

strip_pkgs() {
  # shellcheck disable=SC2016  # single quotes protect the awk program, not shell vars
  rewrite_flake awk -v pkgs="$*" '
    BEGIN { n = split(pkgs, arr, " ") }
    { line = $0; gsub(/^[ \t]+|[ \t]+$/, "", line)
      keep = 1
      for (i = 1; i <= n; i++) if (line == arr[i]) { keep = 0; break }
      if (keep) print }
  '
}

pkg_present() {
  awk -v p="$1" '
    { line = $0; gsub(/^[ \t]+|[ \t]+$/, "", line); if (line == p) found = 1 }
    END { exit !found }' flake.nix
}

cmd_env_init() {
  host_only env init
  [[ -f flake.nix ]] && die "flake.nix already exists — refusing to overwrite"
  local helpers lang="${1:-}" name="${2:-}" project
  helpers="$(template)"
  if [[ -n $lang && ! -d $helpers/$lang ]]; then
    die "unknown language: $lang — available: $(find "$helpers" -maxdepth 1 -mindepth 1 -type d -exec basename {} \; | paste -sd, -)"
  fi
  project="${name:-$(basename "$PWD")}"
  sed "s/PROJECT_NAME/${project}/g" "$helpers/devshell-flake.nix" > flake.nix
  if [[ -n $lang ]]; then
    # shellcheck disable=SC2046
    inject_pkgs $(grep -v '^[[:space:]]*$' "$helpers/$lang/packages")
    [[ -f justfile ]] || install -m 644 "$helpers/$lang/justfile" justfile
  fi
  [[ -f .envrc ]] || echo "use flake" > .envrc
  if [[ -f .gitignore ]]; then
    grep -q '\.direnv' .gitignore || printf '\n.direnv/\n' >> .gitignore
  else
    echo ".direnv/" > .gitignore
  fi
  [[ -d .git ]] || git init -q
  direnv allow
}

cmd_env_add() {
  [[ -f flake.nix ]] || die "no flake.nix — run 'capsule env init' first"
  [[ $# -gt 0 ]] || die "usage: capsule env add <pkg>..."
  local p; local -a fresh=()
  for p in "$@"; do
    case " ${fresh[*]:-} " in *" $p "*) continue ;; esac   # duplicate within this batch
    if pkg_present "$p"; then
      echo "capsule: $p already present — skipping" >&2
    else
      fresh+=("$p")
    fi
  done
  [[ ${#fresh[@]} -gt 0 ]] || { echo "capsule: nothing to add"; return 0; }
  inject_pkgs "${fresh[@]}"
  direnv reload
}

cmd_env_rm() {
  [[ -f flake.nix ]] || die "no flake.nix here"
  [[ $# -gt 0 ]] || die "usage: capsule env rm <pkg>..."
  strip_pkgs "$@"
  direnv reload
}

cmd_env_update() {
  [[ -f flake.nix ]] || die "no flake.nix here"
  nix flake update && direnv reload
}

cmd_env_reload() { direnv reload; }

default_branch() {
  local d
  if d=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null); then
    echo "${d#origin/}"; return
  fi
  for d in main master; do
    if git show-ref --verify --quiet "refs/heads/$d"; then echo "$d"; return; fi
  done
  git rev-parse --abbrev-ref HEAD
}

need_remote() {
  git remote get-url vm >/dev/null 2>&1 \
    || die "no 'vm' remote — run 'capsule run start' once to bootstrap"
}

issue_branch() { # issue_branch <issue-short>
  local full
  full=$(capsuled issue.get "$(project_params),\"id\":$(json_string "$1")}" | jq -r '.id')
  [[ -n $full && $full != null ]] || die "no such issue: $1"
  printf 'capsule/%s' "$full"
}

cmd_run_push()  { host_only run push;  need_remote; git push vm "HEAD:$(issue_branch "$(issue_id_or_pick "${1:-}")")"; }
cmd_run_fetch() { host_only run fetch; need_remote; git fetch -q vm && echo "capsule: fetched"; }

cmd_run_review() {
  host_only run review
  need_daemon
  need_remote
  local issue; issue=$(issue_id_or_pick "${1:-}" ready_for_review) || exit 1
  [[ -n $issue ]] || { echo "nothing selected"; return 1; }

  local branch; branch=$(issue_branch "$issue")
  git fetch -q vm || die "could not fetch from the replica"
  git rev-parse --verify -q "vm/$branch" >/dev/null \
    || die "the replica has no $branch — has this issue been dispatched?"

  if ! command -v tuicr >/dev/null 2>&1 || [[ ! -t 1 ]]; then
    git log -p --reverse "HEAD..vm/$branch"
    return
  fi

  local exported
  exported=$(tuicr --no-update-check --stdout -r "HEAD..vm/$branch")
  if [[ -z $exported ]]; then
    echo "${_d}no comments exported — press y in tuicr to hand them back to the issue${_r}"
    return 0
  fi

  printf '%s\n\n' "$exported"
  local ans
  read -r -n1 -p "attach to the issue for the agent's next run? [y/N] " ans < /dev/tty; echo
  [[ $ans == [yY] ]] || { echo "not attached"; return 0; }
  capsuled issue.comment "$(project_params),\"id\":$(json_string "$issue"),\"text\":$(json_string "$exported")}" \
    && echo "attached"
}

cmd_run_merge() {
  host_only run merge
  need_daemon
  need_remote

  local issue; issue=$(issue_id_or_pick "${1:-}" ready_for_review) || exit 1
  [[ -n $issue ]] || { echo "nothing selected"; return 1; }

  local branch here n
  branch=$(issue_branch "$issue")
  git fetch -q vm || die "could not fetch from the replica"
  git rev-parse --verify -q "vm/$branch" >/dev/null || die "the replica has no $branch"

  here=$(git rev-parse --abbrev-ref HEAD)
  local before; before=$(git rev-parse HEAD)
  n=$(git rev-list --count "HEAD..vm/$branch")
  if (( n == 0 )); then
    echo "nothing to merge — vm/$branch has no commits beyond $here"
    return 0
  fi

  echo "squashing $n commit(s) from vm/$branch into $here:"
  git log --oneline --reverse "HEAD..vm/$branch"
  echo
  git diff --stat "HEAD...vm/$branch"
  echo

  local title message
  title=$(capsuled issue.get "$(project_params),\"id\":$(json_string "$issue")}" | jq -r '.title')
  message=$(capsuled edit "$title" \
    "<!-- the commit message for this merge. it is authored by you, not generated. empty aborts. -->")
  case $? in
    0) ;;
    3) message="$title" ;;
    *) echo "aborted"; return 1 ;;
  esac

  git merge --squash "vm/$branch" || die "the squash did not apply cleanly — resolve it, then commit"
  git commit -q -m "$message" || die "nothing was committed"
  echo "merged as $(git rev-parse --short HEAD)"

  capsuled issue.merge "$(project_params),\"id\":$(json_string "$issue")}" >/dev/null \
    || echo "capsule: merged, but the issue could not be marked done" >&2

  flag_stale_memories "$before" "$here"
  resync_replica "$here"

  offer_memory_review
}

flag_stale_memories() { # flag_stale_memories <before-sha> <branch>
  local before="$1" paths json suspect
  paths=$(git diff --name-status --diff-filter=DR "$before..HEAD" 2>/dev/null | cut -f2) || return 0
  [[ -n $paths ]] || return 0

  json=$(jq -R . <<<"$paths" | jq -cs .)
  suspect=$(capsuled memory.stale "$(project_params),\"paths\":$json}" 2>/dev/null) || return 0
  [[ $suspect == "[]" || -z $suspect ]] && return 0

  echo
  echo "these memories are anchored to files this merge removed or renamed:"
  jq -r '.[] | "   \(.short)  \(.body)"' <<<"$suspect"
  echo "   review them with 'capsule memory review'"
}

resync_replica() { # resync_replica <current-branch>
  local here="$1" main_branch="${CAPSULE_MAIN_BRANCH:-$(default_branch)}"
  if [[ $here != "$main_branch" ]]; then
    echo "on '$here' (not '$main_branch') — replica left as is"
    return 0
  fi
  vm_running || { echo "capsule: VM is down — the replica will be stale until the next run"; return 0; }

  local replica; replica=$(capsuled project.get "$(project_params)}" | jq -r '.replica // empty')
  [[ -n $replica ]] || return 0

  git push -q vm "HEAD:$main_branch" || {
    echo "capsule: merged, but the replica would not accept the push" >&2
    return 0
  }
  if ssh_vm "git -C ~/capsule/$replica checkout -q $main_branch" 2>/dev/null; then
    echo "replica synced — now on $main_branch"
  else
    echo "capsule: merged and pushed, but the replica would not switch to $main_branch." >&2
    echo "         its working tree is probably dirty — 'capsule run attach' and commit or" >&2
    echo "         stash there, or 'capsule vm ssh' to look." >&2
  fi
}

seed_git_identity() {
  local name email
  name=$(git config --get user.name 2>/dev/null || true)
  email=$(git config --get user.email 2>/dev/null || true)
  [[ -n $name || -n $email ]] || return 0
  name=${name//\'/\'\\\'\'}; email=${email//\'/\'\\\'\'}   # single-quote-safe for the remote
  ssh_vm "git config --global --get user.email >/dev/null 2>&1 && exit 0; \
          [ -n '$name' ]  && git config --global user.name  '$name'; \
          [ -n '$email' ] && git config --global user.email '$email'; :"
}

ensure_replica() { # ensure_replica <replica-name> <branch>
  local name="$1" branch="$2" remote_url
  remote_url="ssh://${CAPSULE_VM_HOST}:${CAPSULE_VM_PORT}/home/${CAPSULE_VM_HOST%%@*}/capsule/$name"

  if ! ssh_vm "test -d ~/capsule/$name/.git"; then
    echo "capsule: bootstrapping $name in VM"
    ssh_vm "mkdir -p ~/capsule && git init -q ~/capsule/$name \
      && git -C ~/capsule/$name config receive.denyCurrentBranch updateInstead"
  fi

  # The replica having no remotes is what keeps agent commits off a shared one — a hook
  # matching `git push` is defeated by any indirection. Checked on every start.
  [[ -z "$(ssh_vm "git -C ~/capsule/$name remote")" ]] \
    || die "replica ~/capsule/$name has git remotes — agent commits could escape; refusing"

  git remote get-url vm >/dev/null 2>&1 || git remote add vm "$remote_url"
  git remote set-url vm "$remote_url"

  git push -q vm "HEAD:$branch" || die "could not push $branch to the replica"
  ssh_vm "git -C ~/capsule/$name checkout -q $branch" \
    || die "the replica could not check out $branch — is its working tree dirty? 'capsule vm ssh' to look"
}

reset_vm_side() { # reset_vm_side <replica> <force>
  local replica="$1" force="$2"

  # A squash merge leaves the branch's commits out of main's ancestry, so git cannot answer
  # "is this merged" — the issue states behind gc.branches are the only signal there is.
  if [[ $force != true ]]; then
    local on_replica merged unmerged indent=$'\n  '
    on_replica=$(ssh_vm "git -C ~/capsule/$replica for-each-ref --format='%(refname:short)' refs/heads/capsule/" 2>/dev/null || true)
    if [[ -n $on_replica ]]; then
      merged=$(capsuled gc.branches "$(project_params)}" | jq -r '.[]')
      unmerged=$(comm -23 <(sort <<<"$on_replica") <(sort <<<"$merged"))
      if [[ -n $unmerged ]]; then
        echo "capsule: the replica still holds unmerged work:" >&2
        echo "  ${unmerged//$'\n'/$indent}" >&2
        die "'capsule run fetch' brings the branches here first; --force drops them"
      fi
    fi
  fi

  local runs containers dirs
  runs=$(capsuled gc.runs "$(project_params)}") || exit 1
  containers=$(jq -r '[.[].container] | join(" ")' <<<"$runs")
  dirs=$(jq -r '.[] | "~/.capsule/runs/" + .dir' <<<"$runs" | tr '\n' ' ')

  if [[ -n $containers ]]; then
    ssh_vm "podman rm -f $containers" >/dev/null 2>&1 || true
    ssh_vm "rm -rf $dirs"
  fi
  ssh_vm "rm -rf ~/capsule/$replica"
  printf 'capsule: removed replica %s and %s run dir(s) from the VM\n' \
    "$replica" "$(jq -r 'length' <<<"$runs")"
}

# Dropping the remote takes refs/remotes/vm/* with it, so the replica's branches leave no
# trace here either.
reset_local_side() {
  if git remote get-url vm >/dev/null 2>&1; then
    git remote remove vm
    echo "capsule: removed the 'vm' remote and its tracking refs"
  fi
}

cmd_run_reset() {
  host_only run reset
  need_daemon
  local force=false
  [[ ${1:-} == --force ]] && force=true

  local project replica
  project=$(capsuled project.get "$(project_params)}") \
    || die "not a registered project — nothing to reset"
  replica=$(jq -r '.replica' <<<"$project")

  local live
  live=$(capsuled run.list "$(project_params)}") || exit 1
  [[ $(jq -r 'map(select(.state == "active")) | length' <<<"$live") == 0 ]] \
    || die "a run is still live — 'capsule run end' first"

  vm_reachable
  reset_vm_side "$replica" "$force"
  reset_local_side
  echo "capsule: the project is still registered — 'capsule run start' rebuilds from scratch"
}

profile_dir() { # profile_dir <profile>
  printf '%s/capsule/profiles/%s' "${XDG_CONFIG_HOME:-$HOME/.config}" "$1"
}

# One bare file per value, the shape 'capsule login' writes. The fallback is what the
# agent would otherwise be stopped and asked for on every run.
profile_pref() { # profile_pref <profile> <name> <default>
  local file value=""
  file="$(profile_dir "$1")/$2"
  [[ -f $file ]] && value=$(<"$file")
  printf '%s' "${value:-$3}"
}

seed_to_vm() { # seed_to_vm <run-dir> <issue-short> <title> <project-dir> <run-token> <profile>
  local run_dir="$1" issue="$2" title="$3" proj="$4" run_token="$5" profile="$6"
  local local_seed oauth theme editor_mode
  local_seed=$(mktemp -d)
  # shellcheck disable=SC2064  # expand run_dir now, not at trap time
  trap "rm -rf '$local_seed'" RETURN

  theme=$(profile_pref "$profile" theme dark)
  editor_mode=$(profile_pref "$profile" editor-mode vim)

  capsuled seed "$local_seed/claude" "$issue" "$title" "$proj" "$CAPSULE_MCP_PORT" \
    "$theme" "$editor_mode" \
    || die "could not build the agent-state tree"

  ssh_vm "rm -rf ~/$run_dir && mkdir -p ~/$run_dir"
  tar czf - -C "$local_seed" claude | ssh_vm "tar xzf - -C ~/$run_dir"

  oauth=$(profile_pref "$profile" token "")

  {
    [[ -n $run_token ]] && printf 'CAPSULE_RUN_TOKEN=%s\n' "$run_token"
    [[ -n $oauth ]] && printf 'CLAUDE_CODE_OAUTH_TOKEN=%s\n' "$oauth"
    :
  } | ssh_vm "umask 077 && cat > ~/$run_dir/env"
}

cmd_run_start() {
  host_only run start
  need_daemon

  local project issue_arg="${1:-}"
  project=$(capsuled project.get "$(project_params)}") \
    || die "not a registered project — run 'capsule project add' here first"

  local replica profile
  replica=$(jq -r '.replica' <<<"$project")
  profile=$(jq -r '.profile' <<<"$project")

  vm_reachable

  # in_progress and blocked are offered too: a run that died leaves its issue in one of
  # them, and re-dispatching is how it resumes.
  local issue; issue=$(issue_id_or_pick "$issue_arg" open,in_progress,blocked) || exit 1
  [[ -n $issue ]] || { echo "nothing selected"; return 1; }

  local started
  started=$(capsuled run.start "$(project_params),\"issue\":$(json_string "$issue")}") || exit 1

  local run_id token container branch title issue_short
  run_id=$(jq -r '.run' <<<"$started")
  token=$(jq -r '.token' <<<"$started")
  container=$(jq -r '.container' <<<"$started")
  branch=$(jq -r '.branch' <<<"$started")
  title=$(jq -r '.title' <<<"$started")
  issue_short=$(jq -r '.issue' <<<"$started"); issue_short=${issue_short: -8}

  ensure_replica "$replica" "$branch"

  local run_dir=".capsule/runs/${run_id:0:12}"
  local home; home=$(vm_home)
  seed_to_vm "$run_dir" "$issue_short" "$title" "$home/capsule/$replica" "$token" "$profile"
  seed_git_identity

  printf '\n  capsule  %s  %s\n  %s\n\n' "$issue_short" "$title" "$branch"

  local cmd
  cmd=$(CAPSULE_IMAGE="$CAPSULE_IMAGE" capsuled container-cmd \
          "$container" "$home/capsule/$replica" "$home/$run_dir/claude" \
          "$home/$run_dir/env" "$profile" "$issue_short")

  # Never `eval` this: capsuled quotes it for one shell parse and the remote login shell is
  # that parse. A second one strips the quotes and splits the tmux command into podman args.
  ssh_vm "$cmd" >/dev/null || die "the container did not start"
  ssh_vm "rm -f ~/$run_dir/env"

  cmd_run_attach
}

cmd_run_attach() {
  host_only run attach
  need_daemon
  vm_reachable

  local live container
  live=$(capsuled run.list "$(project_params)}") || exit 1
  container=$(jq -r 'map(select(.state == "active")) | first | .container // empty' <<<"$live")
  [[ -n $container ]] || die "no run is live on this project — 'capsule run start' to begin one"

  ssh_ready
  local cmd; cmd=$(capsuled attach-cmd "$container")
  ssh -t "${ssh_opts[@]}" "$CAPSULE_VM_HOST" "$cmd"

  echo "capsule: detached — the agent is still running. 'capsule run attach' to return."
}

cmd_run_end() {
  host_only run end
  need_daemon

  local live container
  live=$(capsuled run.list "$(project_params)}") || exit 1
  container=$(jq -r 'map(select(.state == "active")) | first | .container // empty' <<<"$live")
  [[ -n $container ]] || die "no run is live on this project"

  capsuled run.end "$(project_params)}" >/dev/null || exit 1

  # The store is the record and it is already updated; the container is tidied only if the
  # VM answers. A run gets stuck precisely when the VM is unreachable, so needing it here
  # would break the command in the one case it exists for.
  if vm_running; then
    ssh_vm "podman rm -f $container" >/dev/null 2>&1 || true
  else
    echo "capsule: VM unreachable — container $container left as it is"
  fi

  echo "capsule: run ended. The issue keeps its state — 'capsule issue state <id> open' to reset it."
}

cmd_run_list() {
  host_only run list
  need_daemon
  capsuled run.list "$(project_params)}"
}

cmd_login() {
  host_only login
  local profile="${1:-default}"
  [[ "$profile" =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid profile '$profile' (use [A-Za-z0-9_-])"
  vm_reachable

  local dir=".capsule/profiles/$profile"
  ssh_vm "mkdir -p ~/$dir/claude"

  cat <<EOF

  capsule login — profile '$profile'

  In the container, run:

      claude setup-token

  and follow the prompts. Copy the token it prints, then exit (ctrl-d), and paste it
  when asked. capsule stores it on this machine and injects it per run; it is never
  written into the container's filesystem.

EOF

  ssh_ready
  ssh -t "${ssh_opts[@]}" "$CAPSULE_VM_HOST" \
    "podman run --rm -it --security-opt label=disable \
       -e CAPSULE_IN_CAPSULE=1 -e CAPSULE_PROFILE=$profile \
       -v capsule-nix:/nix \
       -v ~/$dir/claude:$CAPSULE_CONTAINER_HOME/.claude \
       $CAPSULE_IMAGE"

  local store; store=$(profile_dir "$profile")
  mkdir -p "$store"

  # Seeded once and then left alone: editing these files is how a profile's runs get a
  # different theme or editor mode, so a later login must not overwrite the choice.
  [[ -f $store/theme ]] || printf 'dark\n' > "$store/theme"
  [[ -f $store/editor-mode ]] || printf 'vim\n' > "$store/editor-mode"

  local token
  read -r -s -p "paste the token (input hidden), or press enter to skip: " token < /dev/tty
  echo
  [[ -n $token ]] || { echo "no token stored"; return 0; }

  ( umask 077; printf '%s\n' "$token" > "$store/token" )
  echo "capsule: token stored for profile '$profile'"
}

cmd_image_pull() {
  host_only image pull
  vm_reachable
  drop_nix_volume
  ssh_vm "podman pull $CAPSULE_IMAGE && podman image prune -f"
}

cmd_image_build() {
  host_only image build
  vm_reachable
  local src="$CAPSULE_SRC"
  [[ -d $src/container ]] || die "container/ not found under CAPSULE_SRC ($src)"
  drop_nix_volume
  ssh_vm "rm -rf ~/capsule-src"
  COPYFILE_DISABLE=1 tar czf - -C "$src" --exclude .git --exclude .direnv bin container share \
    | ssh_vm "mkdir -p ~/capsule-src && tar xzf - -C ~/capsule-src"
  ssh_vm "podman build -f ~/capsule-src/container/Dockerfile -t $CAPSULE_IMAGE ~/capsule-src \
          && podman image prune -f"
}

cmd_vm_gc() {
  host_only vm gc
  vm_reachable
  ssh_vm "podman container prune -f && podman image prune -f"
  ssh_vm "podman run --rm -v capsule-nix:/nix -v ~/.capsule/cache:$CAPSULE_CONTAINER_HOME/.cache \
            --security-opt label=disable $CAPSULE_IMAGE -c 'nix-collect-garbage'"
  sweep_branches
  ssh_vm "df -h /"
}

# Merges are squashes, so a branch's commits are not ancestors of main and every git-based
# "is it merged" check answers no. The issue state is the only reliable signal, and
# `archived` is kept: `issue reopen` resumes work there.
sweep_branches() {
  capsuled ping >/dev/null 2>&1 || return 0
  git rev-parse --git-dir >/dev/null 2>&1 || return 0

  local replica branches
  replica=$(capsuled project.get "$(project_params)}" 2>/dev/null \
            | jq -r '.replica // empty') || return 0
  [[ -n $replica ]] || return 0

  branches=$(capsuled gc.branches "$(project_params)}" 2>/dev/null | jq -r '.[]')
  [[ -n $branches ]] || { echo "no merged branches to sweep"; return 0; }

  local branch n=0
  while read -r branch; do
    [[ -n $branch ]] || continue
    ssh_vm "git -C ~/capsule/$replica branch -D $branch" >/dev/null 2>&1 && n=$((n + 1))
  done <<<"$branches"
  echo "swept $n merged branch(es) from the replica"
}

cmd_vm_status() {
  host_only vm status
  local kind="remote"; vm_is_local && kind="local qemu"
  printf 'host    %s:%s (%s)\n' "$CAPSULE_VM_HOST" "$CAPSULE_VM_PORT" "$kind"
  if ! vm_running; then
    printf 'state   unreachable\n'
    return 0
  fi
  printf 'state   up\n'
  printf 'uptime  %s\n' "$(ssh_vm 'uptime -p 2>/dev/null || uptime' || echo unknown)"
}

cmd_vm_disk() {
  host_only vm disk
  qemu_only vm disk
  local img="$CAPSULE_DATA/fcos.qcow2"
  [[ -e $img ]] || die "no VM disk at $img — run 'capsule vm start' first"
  vm_running && echo "capsule: VM is running — sizes may lag slightly" >&2
  qemu-img info -U "$img" | grep -E 'virtual size|disk size'
}

cmd_vm_ssh() {
  host_only vm ssh
  vm_reachable
  ssh_ready
  if [[ $# -eq 0 ]]; then
    exec ssh -t "${ssh_opts[@]}" "$CAPSULE_VM_HOST"
  fi
  exec ssh "${ssh_opts[@]}" "$CAPSULE_VM_HOST" "$@"
}

cmd_vm_stop() {
  host_only vm stop
  qemu_only vm stop
  vm_reachable
  ssh_vm "sudo poweroff" 2>/dev/null || true
  ssh -O exit "${ssh_opts[@]}" "$CAPSULE_VM_HOST" 2>/dev/null || true
  echo "capsule: VM shutting down"
}

cmd_vm_destroy() {
  host_only vm destroy
  qemu_only vm destroy
  local img="$CAPSULE_DATA/fcos.qcow2"
  [[ -e $img ]] || die "no VM disk at $img"
  echo "this deletes the VM disk at $img"
  echo "gone with it: the container image, every project replica, and all agent logins"
  echo "(your projects on this machine are untouched)"
  local ans
  read -r -n1 -p "destroy? [y/N] " ans < /dev/tty || die "not a terminal"
  echo
  [[ $ans == [yY] ]] || { echo "aborted"; return 1; }
  rm -f "$img" "$CAPSULE_DATA/fcos.ign"
  ssh -O exit "${ssh_opts[@]}" "$CAPSULE_VM_HOST" 2>/dev/null || true
  ssh-keygen -R "[${CAPSULE_VM_HOST##*@}]:${CAPSULE_VM_PORT}" >/dev/null 2>&1 || true
  echo "capsule: destroyed — 'capsule vm start' will fetch a fresh disk"
}

cmd_vm_start() {
  host_only vm start
  qemu_only vm start
  [[ "$(uname -m)" == arm64 || "$(uname -m)" == aarch64 ]] \
    || die "capsule vm start only supports aarch64 hosts (found $(uname -m)); point CAPSULE_VM_HOST at a real machine instead"
  [[ -r $CAPSULE_SSH_KEY ]] || die "no ssh public key at $CAPSULE_SSH_KEY (set CAPSULE_SSH_KEY)"

  mkdir -p "$CAPSULE_DATA"
  local img="$CAPSULE_DATA/fcos.qcow2"

  if [[ ! -e $img ]]; then
    ssh-keygen -R "[${CAPSULE_VM_HOST##*@}]:${CAPSULE_VM_PORT}" >/dev/null 2>&1 || true
    echo "capsule: no disk yet, fetching Fedora CoreOS ($CAPSULE_STREAM, aarch64)"
    local meta url want xz got
    meta=$(curl -fsSL "https://builds.coreos.fedoraproject.org/streams/${CAPSULE_STREAM}.json")
    read -r url want <<<"$(jq -r \
      '.architectures.aarch64.artifacts.qemu.formats["qcow2.xz"].disk | "\(.location) \(.sha256)"' \
      <<<"$meta")"
    [[ -n $url && $url != null ]] || die "could not resolve image url from stream metadata"

    xz="$CAPSULE_DATA/${url##*/}"
    curl -fL -C - -o "$xz" "$url"
    got=$(shasum -a 256 "$xz" | cut -d' ' -f1)
    [[ $got == "$want" ]] || die "checksum mismatch on $xz (expected $want, got $got)"

    unxz -c "$xz" > "$img"
    qemu-img resize "$img" "$CAPSULE_DISK_SIZE"
    rm -f "$xz"
  fi

  local ign="$CAPSULE_DATA/fcos.ign"
  sed "s|@SSH_KEY@|$(<"$CAPSULE_SSH_KEY")|" "${CAPSULE_BUTANE:-$CAPSULE_SHARE/fcos.bu.tmpl}" \
    | butane --strict > "$ign"

  local qemu fw
  qemu=$(command -v qemu-system-aarch64) || die "qemu-system-aarch64 not found"
  fw="$(dirname "$(dirname "$(readlink -f "$qemu")")")/share/qemu/edk2-aarch64-code.fd"
  [[ -r $fw ]] || die "UEFI firmware not found at $fw"

  echo "capsule: booting VM (${CAPSULE_VM_CPUS} cpu, ${CAPSULE_VM_MEM}M, ssh on :${CAPSULE_VM_PORT})"
  exec "$qemu" \
    -machine virt,accel=hvf -cpu host \
    -rtc base=utc,clock=host \
    -smp "$CAPSULE_VM_CPUS" -m "$CAPSULE_VM_MEM" \
    -nographic \
    -bios "$fw" \
    -drive "if=virtio,file=$img,discard=unmap,detect-zeroes=unmap" \
    -fw_cfg "name=opt/com.coreos/config,file=$ign" \
    -nic "user,hostfwd=tcp::${CAPSULE_VM_PORT}-:22"
}

if [[ -t 1 ]]; then _b=$'\e[1m'; _d=$'\e[36m'; _r=$'\e[0m'; else _b=''; _d=''; _r=''; fi

usage() {
  cat <<EOF

${_b}capsule${_r} — run coding agents in a container, on a VM, on a git replica

  ${_d}project${_r} which repositories capsule knows about
  ${_d}env${_r}     devshell flake for this project — the only group that works inside a capsule
  ${_d}vm${_r}      the machine the agent runs on
  ${_d}image${_r}   the container image the agent runs in
  ${_d}issue${_r}   the backlog for this project
  ${_d}memory${_r}  what a fresh agent could not work out for itself
  ${_d}run${_r}     hand work to an agent and take it back
  ${_d}daemon${_r}  the host service everything else reads from
  ${_d}board${_r}   the dashboard — read-only, no actions

'capsule <group>' lists that group's commands.

EOF
}

usage_env() {
  cat <<EOF

${_b}capsule env${_r} — the project's Nix devshell

  ${_d}init${_r} [lang] [name]  scaffold flake.nix, .envrc, .gitignore, git repo (host only)
  ${_d}add${_r} <pkg>...        add packages to flake.nix
  ${_d}rm${_r} <pkg>...         remove packages from flake.nix
  ${_d}update${_r}              nix flake update, then reload
  ${_d}reload${_r}              direnv reload

Everything but 'init' works inside a capsule as well as on the host.

EOF
}

usage_vm() {
  cat <<EOF

${_b}capsule vm${_r} — the machine the agent runs on

  ${_d}status${_r}              where the agent host is, and whether it's up
  ${_d}ssh${_r} [cmd...]        ssh into it, or run one command there
  ${_d}gc${_r}                  prune containers/images, collect nix garbage

Local qemu VM only — not available when CAPSULE_VM_HOST names a real machine:

  ${_d}start${_r}               boot it, downloading the disk if needed
  ${_d}stop${_r}                power it off (disk is kept)
  ${_d}disk${_r}                actual vs virtual size of the VM disk
  ${_d}destroy${_r}             delete the VM disk (asks first)

EOF
}

usage_image() {
  cat <<EOF

${_b}capsule image${_r} — the container image the agent runs in

  ${_d}pull${_r}                pull the published image, dropping the stale nix volume
  ${_d}build${_r}               build it locally instead, from this checkout

EOF
}

usage_issue() {
  cat <<INNER

${_b}capsule issue${_r} — the backlog for this project

  ${_d}new${_r} <title>           create one; the body opens in \$EDITOR
  ${_d}list${_r} [state]          every issue, or only those in one state
  ${_d}edit${_r} [id]             edit the body in \$EDITOR
  ${_d}rename${_r} [id] <title>   change the title (no editor: it is one line)
  ${_d}comment${_r} [id]          add a note to the event log
  ${_d}state${_r} [id] <state>    set it by hand: open, in_progress, blocked, ready_for_review
  ${_d}triage${_r}              review everything an agent filed, in one buffer
  ${_d}archive${_r} [id] -m ...  set it aside, with a reason (reversible)
  ${_d}reopen${_r} [id]          bring an archived issue back

Omit the id and a picker opens. Ids resolve by unique prefix, as git resolves a
short SHA, so the short form is enough.

INNER
}

usage_project() {
  cat <<EOF

${_b}capsule project${_r} — which repositories capsule knows about

  ${_d}add${_r} [--profile <name>]  register \$PWD (default profile: default)
  ${_d}list${_r}                    every registered project
  ${_d}profile${_r} <name>          change this project's profile
  ${_d}rm${_r} [--force]            unregister; refuses while issues exist

Registration is explicit and writes nothing into the repository — a project is a row
in the host's store. A profile belongs to the project, not to a run.

${_d}rm${_r} also does what ${_d}capsule run reset${_r} does: the replica, the run directories and the
'vm' remote go with the project. Agent logins are per profile and survive both.

EOF
}

usage_daemon() {
  cat <<EOF

${_b}capsule daemon${_r} — the host service that owns the store and the world model

  ${_d}start${_r}               start it, via the user service if one is installed
  ${_d}stop${_r}                stop it
  ${_d}status${_r}              whether it is up, and what it is holding

EOF
}

usage_run() {
  cat <<EOF

${_b}capsule run${_r} — hand work to an agent and take it back

  ${_d}start${_r} [issue-id]    dispatch an issue to an agent (a picker opens without one)
  ${_d}attach${_r}              reconnect to the live run
  ${_d}end${_r}                 end the live run and remove its container
  ${_d}reset${_r} [--force]     drop this project's replica, run dirs and 'vm' remote
  ${_d}list${_r}                runs on this project, newest first
  ${_d}push${_r} [issue-id]     push HEAD onto that issue's branch in the replica
  ${_d}fetch${_r}               git fetch vm — refs only, nothing else changes
  ${_d}review${_r} [issue-id]   review that issue's branch in tuicr (git log -p without it)
  ${_d}merge${_r} [issue-id]    squash into this branch, mark the issue done, re-sync

EOF
}

die_usage() {
  local group="$1"; shift
  echo "capsule: $*" >&2
  "usage_$group" >&2
  exit 2
}

dispatch_env() {
  local verb="${1:-}"; [[ $# -gt 0 ]] && shift
  case "$verb" in
    init)   cmd_env_init "$@" ;;
    add)    cmd_env_add "$@" ;;
    rm)     cmd_env_rm "$@" ;;
    update) cmd_env_update ;;
    reload) cmd_env_reload ;;
    ""|help) usage_env ;;
    *)      die_usage env "unknown command 'env $verb'" ;;
  esac
}

dispatch_vm() {
  local verb="${1:-}"; [[ $# -gt 0 ]] && shift
  case "$verb" in
    status)  cmd_vm_status ;;
    start)   cmd_vm_start ;;
    stop)    cmd_vm_stop ;;
    ssh)     cmd_vm_ssh "$@" ;;
    disk)    cmd_vm_disk ;;
    gc)      cmd_vm_gc ;;
    destroy) cmd_vm_destroy ;;
    ""|help) usage_vm ;;
    *)       die_usage vm "unknown command 'vm $verb'" ;;
  esac
}

dispatch_image() {
  local verb="${1:-}"; [[ $# -gt 0 ]] && shift
  case "$verb" in
    pull)    cmd_image_pull ;;
    build)   cmd_image_build ;;
    ""|help) usage_image ;;
    *)       die_usage image "unknown command 'image $verb'" ;;
  esac
}

dispatch_memory() {
  local verb="${1:-}"; [[ $# -gt 0 ]] && shift
  case "$verb" in
    list)    cmd_memory_list ;;
    review)  cmd_memory_review ;;
    new)     cmd_memory_new ;;
    ""|help) usage_memory ;;
    *)       die_usage memory "unknown command 'memory $verb'" ;;
  esac
}

usage_memory() {
  cat <<INNER

${_b}capsule memory${_r} — what a fresh agent could not work out for itself

  ${_d}list${_r}                every memory and its state
  ${_d}review${_r}              review proposals and prune the active set
  ${_d}new${_r}                 write one by hand

Memories are injected into every agent session for this project. The cap is 40 active
and it is enforced: accepting at the cap requires deactivating one in the same pass.
That refusal is the entire reason curation happens.

INNER
}

dispatch_issue() {
  local verb="${1:-}"; [[ $# -gt 0 ]] && shift
  case "$verb" in
    new)     cmd_issue_new "$@" ;;
    list)    cmd_issue_list "$@" ;;
    edit)    cmd_issue_edit "$@" ;;
    rename)  cmd_issue_rename "$@" ;;
    comment) cmd_issue_comment "$@" ;;
    state)   cmd_issue_state "$@" ;;
    triage)  cmd_issue_triage ;;
    archive) cmd_issue_archive "$@" ;;
    reopen)  cmd_issue_reopen "$@" ;;
    ""|help) usage_issue ;;
    *)       die_usage issue "unknown command 'issue $verb'" ;;
  esac
}

dispatch_project() {
  local verb="${1:-}"; [[ $# -gt 0 ]] && shift
  case "$verb" in
    add)     cmd_project_add "$@" ;;
    list)    cmd_project_list ;;
    rm)      cmd_project_rm "$@" ;;
    profile) cmd_project_profile "$@" ;;
    ""|help) usage_project ;;
    *)       die_usage project "unknown command 'project $verb'" ;;
  esac
}

dispatch_daemon() {
  local verb="${1:-}"; [[ $# -gt 0 ]] && shift
  case "$verb" in
    start)   cmd_daemon_start ;;
    stop)    cmd_daemon_stop ;;
    status)  cmd_daemon_status ;;
    ""|help) usage_daemon ;;
    *)       die_usage daemon "unknown command 'daemon $verb'" ;;
  esac
}

dispatch_run() {
  local verb="${1:-}"; [[ $# -gt 0 ]] && shift
  case "$verb" in
    start)   cmd_run_start "$@" ;;
    attach)  cmd_run_attach ;;
    end)     cmd_run_end ;;
    reset)   cmd_run_reset "$@" ;;
    list)    cmd_run_list ;;
    push)    cmd_run_push "$@" ;;
    fetch)   cmd_run_fetch ;;
    review)  cmd_run_review "$@" ;;
    merge)   cmd_run_merge "$@" ;;
    ""|help) usage_run ;;
    *)       die_usage run "unknown command 'run $verb'" ;;
  esac
}

main() {
  local group="${1:-}"; [[ $# -gt 0 ]] && shift
  case "$group" in
    project|env|vm|image|run|issue|memory|daemon) "dispatch_$group" "$@" ;;
    board) cmd_board ;;
    login) cmd_login "$@" ;;
    ""|help|-h|--help) usage ;;
    *) echo "capsule: unknown command group '$group'" >&2; usage >&2; exit 2 ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "${0}" ]]; then
  main "$@"
fi
